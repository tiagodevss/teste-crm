{
  "name": "wms-empresarial-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "msw": {"workerDirectory": "public"},
  "scripts": {
    "dev": "vite --mode demo",
    "build": "vite build --mode demo",
    "build:pages": "vite build --mode pages --base=/teste-crm/",
    "preview": "vite preview --mode demo",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "npm run test:feedback && npm run test:demo",
    "test:feedback": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:demo": "node --experimental-strip-types --test tests/demo/*.test.mjs",
    "test:demo:browser": "python tests/demo/browser.py",
    "test:demo:audit": "python tests/demo/audit_regression.py",
    "test:pages": "python tests/demo/pages.py",
    "package:demo": "node scripts/package-demo.mjs",
    "dev:demo": "npm run dev",
    "build:demo": "npm run build",
    "preview:demo": "npm run preview"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.21",
    "@xyflow/react": "^12.10.0",
    "axios": "^1.13.4",
    "firebase": "^12.9.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.563.0",
    "msw": "^2.12.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-easy-crop": "^5.4.1",
    "react-hook-form": "^7.71.1",
    "react-hot-toast": "^2.6.0",
    "react-is": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "socket.io-client": "^4.8.3",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {"node": ">=22 <23"}
}
